# DCS-PIS local environment. Create your own with `make env` (scripts/gen_env.py fills random secrets).
# NEVER commit .env. Real credentials for staging/prod come only from the secrets manager.

DCS_ENV=local

# --- Postgres (cluster admin + control DB roles)
POSTGRES_PASSWORD=change-me
DCS_CONTROL_OWNER_PASSWORD=change-me
DCS_CONTROL_APP_PASSWORD=change-me
DCS_CONTROL_READER_PASSWORD=change-me

# --- Local key service (dev KMS): base64 of 32 random bytes
DCS_LOCAL_MASTER_KEY=change-me

# --- S3-compatible object store (RustFS in dev)
S3_ACCESS_KEY=dcs-local
S3_SECRET_KEY=change-me

# --- Keycloak
KEYCLOAK_ADMIN_PASSWORD=change-me
DCS_KC_WEB_CLIENT_SECRET=change-me
DCS_KC_ADMIN_CLIENT_SECRET=change-me
DCS_KC_CONTROL_API_CLIENT_SECRET=change-me
# First staff login (realm dcs-staff, user "staff@dcs.local"); must be changed on first login
DCS_KC_STAFF_PASSWORD=change-me
# "keycloak" until the Keycloakify theme JAR is built (apps/keycloak-theme), then "dcs"
DCS_KC_LOGIN_THEME=keycloak

# --- Auth.js session encryption (one per Next.js app)
AUTH_SECRET_WEB=change-me
AUTH_SECRET_ADMIN=change-me

# --- Optional
SENTRY_DSN=
PG_PORT=5432
