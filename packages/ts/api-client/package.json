{
  "name": "@dcs/api-client",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "openapi-typescript openapi/control.json -o src/generated/control.ts && openapi-typescript openapi/data.json -o src/generated/data.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src"
  },
  "dependencies": {
    "openapi-fetch": "^0.13.4"
  },
  "devDependencies": {
    "@dcs/config": "workspace:*",
    "eslint": "^9.17.0",
    "openapi-typescript": "^7.5.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
